<resources>

    <!-- Material 3 theme. Dynamic color (Material You) is applied at runtime on
         Android 12+; this theme provides the fallback palette. -->
    <style name="Theme.AllTrans" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <!-- Explicit container roles: the bottom bar and cards read these, and
             relying on the parent's DayNight values produced dark surfaces in
             forced light mode. -->
        <item name="colorSurfaceContainerLowest">#FFFFFF</item>
        <item name="colorSurfaceContainerLow">#F7F2FA</item>
        <item name="colorSurfaceContainer">#F3EDF7</item>
        <item name="colorSurfaceContainerHigh">#ECE6F0</item>
        <item name="colorSurfaceContainerHighest">#E6E0E9</item>
        <item name="android:windowBackground">@color/md_surface</item>
        <item name="android:textColorPrimary">@color/md_on_surface</item>
        <item name="android:textColorSecondary">@color/md_on_surface_variant</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="preferenceTheme">@style/Theme.AllTrans.Preference</item>
    </style>

    <!-- The stock preference overlay resolved its text colours from the night
         palette, producing light text on light surfaces. Bind them to our own
         per-configuration colour resources instead. -->
    <style name="Theme.AllTrans.Preference" parent="@style/PreferenceThemeOverlay">
        <item name="android:textColorPrimary">@color/md_on_surface</item>
        <item name="android:textColorSecondary">@color/md_on_surface_variant</item>
    </style>

    <!-- AMOLED variant: pure black surfaces for dark mode. -->
    <style name="Theme.AllTrans.Amoled" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorSurface">@android:color/black</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">#202020</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@android:color/black</item>
        <item name="colorSurfaceContainerLow">@android:color/black</item>
        <item name="colorSurfaceContainer">@android:color/black</item>
        <item name="colorSurfaceContainerHigh">@android:color/black</item>
        <item name="colorSurfaceContainerHighest">#121212</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:textColorPrimary">@color/md_on_surface</item>
        <item name="android:textColorSecondary">@color/md_on_surface_variant</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="preferenceTheme">@style/Theme.AllTrans.Preference</item>
    </style>

    <!-- Keep the old entry point working. -->
    <style name="AppTheme" parent="Theme.AllTrans" />

    <!-- Legacy style names still referenced by layouts. -->
    <style name="ToolBarStyle" parent="Widget.Material3.Toolbar" />
    <style name="ToolBarStyle.Base" parent="">
        <item name="popupTheme">@style/ThemeOverlay.Material3.Dark</item>
        <item name="theme">@style/ThemeOverlay.Material3.ActionBar</item>
    </style>
    <style name="ToolBarStyle.Event" parent="ToolBarStyle" />
    <style name="TextAppearance.Widget.Event.Toolbar.Title" parent="TextAppearance.Material3.TitleLarge" />
    <style name="CustomTabLayoutStyle" parent="Widget.Material3.TabLayout" />
    <style name="CustomTabTexStyle" parent="TextAppearance.Material3.TitleSmall" />
</resources>
